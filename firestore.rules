rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // POSTS: world-readable, owned by the uid that wrote them.
    //
    // Posts written before authorId existed carry only a display name, which
    // is not unique, so they have no owner here: nobody can edit or delete
    // them from the app. Removing one is left to the console.

    function isPostAuthor() {
      return isSignedIn() && resource.data.get('authorId', null) == request.auth.uid;
    }

    /** What liking a post changes. */
    function onlyLikes() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likes', 'likedBy']);
    }

    /**
     * Posts once carried their comments as one array, rewritten whole to
     * like or delete one, so no rule could tell whose comment changed. They
     * are documents of their own now (below). What is left in an array waits
     * for scripts/migrate-comments.mjs, which runs as admin, and is frozen
     * until then — for the post's author too: the app still shows it, and
     * whoever can write it can put words in other people's mouths.
     */
    function leavesLegacyCommentsAlone() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['comments']);
    }

    function postAuthorOf(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.get('authorId', null);
    }

    /**
     * A comment exactly as addComment writes it (services/comments.ts): under
     * the caller's uid, unliked, on a post that exists.
     */
    function isNewComment(postId) {
      let comment = request.resource.data;
      return comment.keys().hasOnly(['authorId', 'authorName', 'authorType', 'content',
                                     'timestamp', 'likes', 'likedBy', 'parentId'])
          && comment.authorId == request.auth.uid
          && comment.authorName is string && comment.authorName.size() > 0 && comment.authorName.size() <= 100
          && comment.authorType in ['human', 'agent']
          // MAX_COMMENT_LENGTH in services/comments.ts.
          && comment.content is string && comment.content.size() > 0 && comment.content.size() <= 4000
          && comment.timestamp is number
          && comment.likes == 0 && comment.likedBy == []
          && (!('parentId' in comment) || comment.parentId is string)
          && exists(/databases/$(database)/documents/posts/$(postId));
    }

    /**
     * A like or an unlike by the caller, and nothing else: their own uid put
     * into likedBy or taken out, and the count moved by one the same way.
     * Tolerates the fields missing, as on comments migrated from the array.
     */
    function togglesOwnLike() {
      let me = request.auth.uid;
      let before = resource.data.get('likedBy', []);
      let after = request.resource.data.get('likedBy', []);
      let delta = request.resource.data.get('likes', 0) - resource.data.get('likes', 0);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
          && ((!(me in before) && delta == 1
                && after.size() == before.size() + 1
                && after.toSet() == before.toSet().union([me].toSet()))
              || (me in before && delta == -1
                && after.size() == before.size() - 1
                && after.toSet() == before.toSet().difference([me].toSet())));
    }

    match /posts/{postId} {
      allow read: if true;

      // Under your own uid only — otherwise the update rule below could be
      // sidestepped by writing a fresh post in someone else's name. An empty
      // comments array is still let through for clients from before.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.get('comments', []).size() == 0;

      // The author edits their post but cannot hand it to someone else.
      // Everyone else may like it, and change nothing else.
      allow update: if (isPostAuthor()
                        && request.resource.data.authorId == resource.data.authorId
                        && leavesLegacyCommentsAlone())
                    || (isSignedIn() && onlyLikes());

      // By uid only: two people may share a display name.
      allow delete: if isPostAuthor();

      // COMMENTS: world-readable like the post. Anyone signed in comments as
      // themselves — an agent's comment under the uid of whoever runs it.
      match /comments/{commentId} {
        allow read: if true;

        allow create: if isSignedIn() && isNewComment(postId);

        // Nobody edits a comment; anyone may like or unlike it in their own
        // name only.
        allow update: if isSignedIn() && togglesOwnLike();

        // Its author, or the post's author moderating their thread. By uid,
        // so a comment from before authorId existed is the post author's
        // alone to remove.
        allow delete: if isSignedIn()
                      && (resource.data.get('authorId', null) == request.auth.uid
                          || postAuthorOf(postId) == request.auth.uid);
      }
    }

    // USERS:
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;

      // Private per-user state (read marks). The profile above is world
      // readable; when someone last opened a thread is not.
      match /private/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // GLOBAL STATS:
    match /global_stats/{docId} {
      allow read: if true;
      allow write: if isSignedIn(); // In a real app, restrict to server/admin
    }

    // SYSTEM LOGS:
    match /system_logs/{logId} {
      allow read: if isSignedIn(); // Only members can see system health
      allow create: if isSignedIn();
      allow update, delete: if false; // Logs are immutable
    }

    // --- DIRECT MESSAGES ---

    function conversationData(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    function isParticipant(conversationId) {
      return isSignedIn() && request.auth.uid in conversationData(conversationId).participantIds;
    }

    /** Every participant has removed the thread from their own list. */
    function bothHaveHidden(conversation) {
      return conversation.get('deletedFor', []).hasAll(conversation.participantIds);
    }

    match /conversations/{conversationId} {
      // get and list are split because a conversation is opened by reading a
      // deterministic id that may not exist yet. On a missing document
      // `resource` is null, so a rule touching resource.data denies the read
      // and the thread can never be created.
      allow get: if isSignedIn()
                 && (resource == null || request.auth.uid in resource.data.participantIds);

      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      // Exactly two people, and the creator must be one of them — otherwise a
      // user could open a thread between two other accounts.
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.participantIds.size() == 2;

      // Participants update only the preview fields; the roster is fixed at
      // creation so nobody can add themselves to someone else's thread.
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participantIds
                    && request.resource.data.participantIds == resource.data.participantIds
                    && request.resource.data.participants == resource.data.participants;

      // Removing the thread outright is only allowed once the other side has
      // also hidden it — otherwise one participant could destroy the other's
      // copy of a shared conversation.
      allow delete: if isSignedIn()
                    && request.auth.uid in resource.data.participantIds
                    && bothHaveHidden(resource.data);

      match /messages/{messageId} {
        allow read: if isParticipant(conversationId);

        allow create: if isParticipant(conversationId)
                      && request.resource.data.authorId == request.auth.uid;

        // Editing and soft-deleting are the author's alone, and the author
        // cannot be reassigned by an edit.
        allow update: if isSignedIn()
                      && resource.data.authorId == request.auth.uid
                      && request.resource.data.authorId == resource.data.authorId;

        // Normally only the author may delete their own message. The exception
        // is the final purge: once both participants have hidden the thread,
        // either may clear out what is left.
        allow delete: if isSignedIn()
                      && (resource.data.authorId == request.auth.uid
                          || bothHaveHidden(conversationData(conversationId)));
      }
    }

    // --- BOARDS (Slack-like spaces for humans + AI agents) ---

    function boardData(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId)).data;
    }

    function isBoardMember(boardId) {
      return isSignedIn() && request.auth.uid in boardData(boardId).memberIds;
    }

    /** An edit touching nothing but the denormalized last-message fields. */
    function onlyStampsLastMessage() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessageAt', 'lastMessageAuthorId']);
    }

    function isBoardOwner(boardId) {
      return isSignedIn() && boardData(boardId).ownerId == request.auth.uid;
    }

    // BOARDS: only members can read; only the owner can reconfigure or delete.
    //
    // Channels and messages are nested subcollections so these rules can take
    // the board id from the document PATH. A path-based get() is evaluated once
    // per query; deriving it from document data instead would mean one lookup
    // per matched document, which Firestore rejects on list operations.
    match /boards/{boardId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      // The owner reconfigures the board. Any member may additionally stamp
      // the last-message fields, which is how unread dots are drawn without a
      // listener per channel — and nothing else, so a member cannot rename the
      // board or edit its roster through this door.
      allow update: if isSignedIn()
                    && (resource.data.ownerId == request.auth.uid
                        || (request.auth.uid in resource.data.memberIds && onlyStampsLastMessage()));

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // NOTES: the board's long-term agent memory. Bots write them from the
      // browser of whoever invoked them, so any member may add one. They are
      // shared knowledge of the board, and any member may correct them.
      match /notes/{noteId} {
        allow read: if isBoardMember(boardId);
        allow create: if isBoardMember(boardId)
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 600;
        allow delete: if isBoardMember(boardId);
        // Only a note's vector may change after it is filed — for semantic
        // search, added to notes written before it was switched on.
        allow update: if isBoardMember(boardId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['embedding', 'embeddingModel'])
                      && request.resource.data.embedding is string
                      && request.resource.data.embedding.size() <= 20000;
      }

      // TASKS: orchestrated meetings running on the server. The worker writes
      // them as the member who started the task, so these rules bind it too.
      // Any member may ask a task to stop, and change nothing else.
      match /tasks/{taskId} {
        allow read: if isBoardMember(boardId);
        allow create: if isBoardMember(boardId)
                      && request.resource.data.startedBy == request.auth.uid;
        allow update: if isSignedIn()
                      && (resource.data.startedBy == request.auth.uid
                          || (isBoardMember(boardId)
                              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelRequested'])));
        allow delete: if isSignedIn()
                      && (resource.data.startedBy == request.auth.uid || isBoardOwner(boardId));
      }

      // CHANNELS: readable by board members, managed by the board owner.
      match /channels/{channelId} {
        // MEMORY: the channel's running summary, kept up to date by any member
        // whose request triggered a compaction.
        match /memory/{docId} {
          allow read, write: if isBoardMember(boardId);
        }

        allow read: if isBoardMember(boardId);
        allow create, delete: if isBoardOwner(boardId);

        allow update: if isBoardOwner(boardId)
                      || (isBoardMember(boardId) && onlyStampsLastMessage());

        // MESSAGES: board members can read and post. A member may only post as
        // themselves or on behalf of a bot that belongs to the same board.
        //
        // A bot's reply is written by whoever invoked it (their browser, or the
        // worker with their token), so its author is legitimately not the
        // caller. The board's botIds list says which ids those are. The app
        // puts only generated bot ids there, never a person's uid (botIdsOf in
        // services/mentions.ts), and only the board owner can change it. A
        // board without the list has no bots anyone may post as.
        match /messages/{messageId} {
          allow read: if isBoardMember(boardId);

          allow create: if isBoardMember(boardId)
                        && (request.resource.data.authorId == request.auth.uid
                            || request.resource.data.authorId in boardData(boardId).get('botIds', []));

          allow update: if false; // Messages are immutable

          // Authors delete their own messages; the owner can moderate any of them.
          allow delete: if isSignedIn()
                        && (resource.data.authorId == request.auth.uid
                            || isBoardOwner(boardId));
        }
      }
    }
  }
}