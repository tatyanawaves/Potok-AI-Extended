# Copy to .env.local and fill in. .env.local is gitignored.

# Deployed URL of worker/ — the agent worker that holds the shared LLM key.
# When set, board agents answer on that shared key instead of the signed-in
# user's own key. Leave empty to fall back to per-user keys from Settings.
VITE_AGENT_WORKER_URL=

# Optional per-user defaults. These are baked into the client bundle at build
# time and are therefore visible to anyone using the app — only put keys here
# that you are willing to expose. Prefer entering keys in the app's Settings.
VITE_OPENROUTER_API_KEY=
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=
