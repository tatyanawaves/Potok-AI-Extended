# Copy to .env.local and fill in. .env.local is gitignored.

# Deployed URL of worker/ — the Pipedream Connect bridge. Bots reach Pipedream
# integrations through it; without it they can still use MCP servers that allow
# browser origins directly. See worker/README.md.
VITE_PIPEDREAM_WORKER_URL=

# Optional per-user defaults. These are baked into the client bundle at build
# time and are therefore visible to anyone using the app — only put keys here
# that you are willing to expose. Prefer entering keys in the app's Settings,
# where they stay in the browser of the person who owns them.
VITE_OPENROUTER_API_KEY=
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=
