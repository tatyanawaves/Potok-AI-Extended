# Local test build: `npm run dev:test` (or vite --mode emulator).
# Talks to the Firebase emulators under the throwaway project "demo-potok"
# instead of production, and offers a one-click test sign-in. Nothing here is
# a secret; it is committed so the setup is reproducible.
VITE_FIREBASE_EMULATORS=1

# The attachment/Pipedream worker verifies tokens of the real project and
# would refuse emulator ones, so it is switched off in this mode.
VITE_PIPEDREAM_WORKER_URL=
